# Sovereign Intelligence - Environment Variables
# Copy this to .env.local for local development
# Add these to Vercel Dashboard > Settings > Environment Variables for production

# OpenAI API Key (Required for AI features)
OPENAI_API_KEY=sk-your-openai-key-here

# Application URL (Vercel sets this automatically)
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: Database (if needed later)
# DATABASE_URL=postgresql://...

# Optional: Authentication (if needed later)
# NEXTAUTH_SECRET=your-secret-here
# NEXTAUTH_URL=https://your-domain.vercel.app
