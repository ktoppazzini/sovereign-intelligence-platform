    const samples = bodyRows.map(row => Array.from(row.matchAll(/<(th|td)\b[^>]*>([\s\S]*?)<\/\1>/gi)).map(m=>m[2].replace(/<[^>]*>/g,'').replace(/\s+/g,' ').trim()).filter(Boolean).join(' | '));

