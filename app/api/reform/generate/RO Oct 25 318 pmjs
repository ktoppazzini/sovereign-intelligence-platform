    const ds0 = (cand.datasets && cand.datasets[0]) ? cand.datasets[0] : (cand.datasets ? (cand.datasets[0] = {label:'Predicted', data: []}) : (cand.datasets = [{label:'Predicted', data: []}], cand.datasets[0]));
    const data = Array.isArray(ds0.data) ? ds0.data : [];
    const L = labels.length || data.length || 3;
    if (!Array.isArray(cand.labels) || cand.labels.length !== L){
      const unit = (String(cand.xTitle||'').toLowerCase().includes('month')) ? 'M':'Y';
      cand.labels = Array.from({length: L}, (_,i)=> unit + (i+1));
    }
    if (!Array.isArray(ds0.data) || ds0.data.length !== cand.labels.length){
      ds0.data = Array.from({length: cand.labels.length}, (_,i)=> i+1);
    }
    // If all zeros or all equal, synthesize a small upward trend
    const nums = ds0.data.map(n => Number(n));
    const allZero = nums.every(n => !isFinite(n) || n===0);
    const allEqual = nums.every(n => n === nums[0]);
    if (allZero || allEqual){
      const base = 10;
      ds0.data = Array.from({length: cand.labels.length}, (_,i)=> base + i*2);
    }
    // Ensure numbers
    ds0.data = ds0.data.map(n => {
      const v = Number(n);
      return isFinite(v) ? v : 0;
    });
    cand.datasets[0] = ds0;
    return cand;
  }catch{ return c; }
}
function _normalizeCandidate(section, c){
  // some LLM responses may give a bare string like 'Y1' — coerce into object
  if (typeof c === 'string'){
    return { type:'line', title:`${String(section).toUpperCase()} Forecast`, xTitle:'Years', yTitle:'Percent', labels:['Y1','Y2','Y3'], datasets:[{ label:'Series', data:[0,0,0] }] };
  }
  if (!c || typeof c !== 'object') return { type:'line', title:`${String(section).toUpperCase()} Forecast`, xTitle:'Years', yTitle:'Percent', labels:['Y1','Y2','Y3'], datasets:[{ label:'Series', data:[0,0,0] }] };
  return c;
}
function _isValidType(type){ return ['line','bar','pie','doughnut'].includes(String(type||'').toLowerCase()); }
function mergeSynth(section, canon, c){
  c = _normalizeCandidate(section, c);
  const merged = JSON.parse(JSON.stringify(c||{}));
  merged.type = _isValidType(merged.type)?merged.type:'line';
  merged.title = merged.title || `${String(section).toUpperCase()} Forecast`;
  merged.xTitle = merged.xTitle || 'Years';
  merged.yTitle = merged.yTitle || (section==='financials'?'CAD':'Percent');
  const labels = Array.isArray(merged.labels) && merged.labels.length ? merged.labels : ['Y1','Y2','Y3'];
  merged.labels = labels;
  merged.datasets = Array.isArray(merged.datasets) && merged.datasets.length ? merged.datasets : [{ label:'Predicted', data:[1,2,3] }];
  return merged;
}
function renderCandidateToFragment(section, c){
  const spec = {
    type: String(c.type||'line').toLowerCase(),
    title: c.title, xTitle: c.xTitle, yTitle: c.yTitle,
    labels: c.labels, datasets: c.datasets
  };
  return `<figure data-chart="${toAttrJSON(spec)}" data-origin="predictive"></figure>`;
}

