/* [KT:SURGICAL:MERGE-2025-10-26] Ensure predictive title is distinct from standard */
function enforcePredictiveTitlePrefix(section, fragHtml){
  try{
    const html = String(fragHtml||'');
    return html.replace(/data-chart=(['"])(.*?)\1/gi, (m, q, jsonStr) => {
      try{
        const conf = JSON.parse(jsonStr);
        const t = String(conf.title||`${String(section).toUpperCase()} Forecast`);
        conf.title = t.toLowerCase().startsWith('predictive — ') ? t : `Predictive — ${t}`;
        return `data-chart=${q}${JSON.stringify(conf)}${q}`;
      }catch{ return m; }
    });
  }catch{ return fragHtml; }
}

function synthTitleIfMissing(section, fragHtml){
  try{
    const html = String(fragHtml||'');
    // If a title is already present inside the config JSON, just return as-is
    const meta = parseVizMeta(html);
    if (meta && meta.title && String(meta.title).trim().length > 0) return html;

    // Otherwise, add a sensible title into the embedded config JSON
    // We search for data-chart="\"{...}\"" and patch "title" if missing.
    return html.replace(/data-chart=(['"])(.*?)\1/gi, (m, q, jsonStr) => {
      try{
        const conf = JSON.parse(jsonStr);
        if (!conf.title || !String(conf.title).trim()){
          const y = conf.yTitle || (section==='financials'?'CAD':'Percent');
          const x = conf.xTitle || 'Years';
          conf.title = `${String(section).toUpperCase()} Forecast (${y} vs ${x})`;
        }
        return `data-chart=${q}${JSON.stringify(conf)}${q}`;
      }catch{
        return m;
      }
    });
  }catch(e){
    console.log(TAG, 'synthTitleIfMissing.error', section, String(e?.message||e));
    return fragHtml;
  }
}


