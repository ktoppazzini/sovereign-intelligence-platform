    const t = String(meta?.type||'chart').toLowerCase();
    const x = meta?.xTitle || 'time';
    const y = meta?.yTitle || 'performance';
    const title = meta?.title || `${String(section).toUpperCase()} Forecast`;
    const base =
      `Predictive ${t} titled “${title}” measures ${y} versus ${x}. ` +
      `Trend suggests directional change over the horizon with volatility concentrated in the midpoint. ` +
      `Leaders should align controls to capture upside while limiting exposure to downside.`;
    // If OpenAI is available, try to sharpen to 2–3 crisp sentences.
    try{
      const openai = await getOpenAI?.();
      if (!openai) return `<p class="chart-note">${base}</p>`;
      const sys = 'Write 2–3 concise sentences. No run-ons. Audience: C‑suite. Avoid hedging.';
      const user = `Context: section=${section}; title=${title}; x=${x}; y=${y}; type=${t}.
Return only the description paragraph (no quotes, no JSON).`;
      const r = await openai.chat.completions.create({
        model: MODEL, temperature: 1,
