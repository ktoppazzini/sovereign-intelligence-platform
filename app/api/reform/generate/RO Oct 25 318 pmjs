/* [KT:SURGICAL:MERGE-2025-10-26] Missing helper restored */
function isGraphCandidateValid(section, c){
  try{
    const type = String(c?.type||'line').toLowerCase();
    const labels = Array.isArray(c?.labels) ? c.labels : [];
    const datasets = Array.isArray(c?.datasets) ? c.datasets : [];
    if (!['line','bar','pie','doughnut'].includes(type)) return false;
    if ((type==='line' || type==='bar') && (labels.length < 3)) return false;
    if ((type==='line' || type==='bar')){
      for (const ds of datasets){
        if (!Array.isArray(ds?.data) || ds.data.length !== labels.length) return false;
        if (ds.data.every((v)=>typeof v==='number' && v===0)) return false;
      }
    }
    return true;
  }catch{ return false; }
}

