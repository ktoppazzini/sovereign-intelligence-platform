      `Samples: ${samples.join(' || ') || '(none)'}`,
      'Create a precise executive title (no word "table").'
    ].join('\n');

    const r = await openai.chat.completions.create({ model: MODEL, temperature: 1, messages:[
      { role:'system', content: sys }, { role:'user', content: usr }
