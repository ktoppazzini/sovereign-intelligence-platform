// app/admin/languages/page.jsx
'use client';

import { useEffect, useMemo, useState } from 'react';
import { useSearchParams } from 'next/navigation';

export default function AdminLanguages() {
  const sp = useSearchParams();
  const lang = sp.get('lang') || 'English';
  const [list, setList] = useState([]);
  const [loading, setLoading] = useState(true);

  const isRTL = useMemo(
    () => ['Arabic', 'Hebrew', 'Urdu', 'Farsi', 'Persian'].some((l) => lang.includes(l)),
    [lang],
  );

  useEffect(() => {
    let gone = false;
    (async () => {
      setLoading(true);
      try {
        const r = await fetch('/api/getLanguagesFromAirtable?mode=full', { cache: 'no-store' });
        const j = await r.json();
        if (!gone) setList(Array.isArray(j.languages) ? j.languages : []);
      } catch {
        if (!gone) setList([]);
      } finally {
        if (!gone) setLoading(false);
      }
    })();
    return () => {
      gone = true;
    };
  }, []);

  return (
    <main
      style={{ maxWidth: 960, margin: '32px auto', padding: '0 16px' }}
      dir={isRTL ? 'rtl' : 'ltr'}
    >
      <h1 style={{ fontWeight: 900, fontSize: 26, marginBottom: 12 }}>Languages</h1>
      <p style={{ marginBottom: 16, color: '#444' }}>
        Source: <code>/api/getLanguagesFromAirtable?mode=full</code>
      </p>

      {loading ? (
        <div>Loading…</div>
      ) : (
        <div style={{ border: '1px solid #e5e7eb', borderRadius: 10, overflow: 'hidden' }}>
          <table style={{ width: '100%', borderCollapse: 'collapse' }}>
            <thead style={{ background: '#f8fafc' }}>
              <tr>
                <th
                  style={{
                    textAlign: 'left',
                    padding: '10px 12px',
                    borderBottom: '1px solid #e5e7eb',
                  }}
                >
                  #
                </th>
                <th
                  style={{
                    textAlign: 'left',
                    padding: '10px 12px',
                    borderBottom: '1px solid #e5e7eb',
                  }}
                >
                  Language
                </th>
              </tr>
            </thead>
            <tbody>
              {list.map((name, idx) => (
                <tr key={`${name}-${idx}`} style={{ borderTop: '1px solid #f1f5f9' }}>
                  <td style={{ padding: '10px 12px', width: 64 }}>{idx + 1}</td>
                  <td style={{ padding: '10px 12px' }}>{name}</td>
                </tr>
              ))}
              {list.length === 0 && (
                <tr>
                  <td colSpan={2} style={{ padding: 16, color: '#666' }}>
                    No languages found.
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      )}
    </main>
  );
}
